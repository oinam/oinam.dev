{
  "name": "oinam.dev",
  "version": "0.1.0",
  "description": "Design and development assets, ideas, and standards for AI, and their agents, tools, and harnesses.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://oinam.dev",
  "repository": "github:oinam/oinam.dev",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler pages dev public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:html": "html-validate \"public/**/*.html\"",
    "test": "node --test",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0"
  }
}
