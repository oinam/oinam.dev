# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# The site is static and loads nothing from anyone else, so every other door can be shut.
# The content policy allows only the site's own files, no plugins, no framing, and no form
# posts. HTTPS is remembered for a year; subdomains are left to choose for themselves. The
# permissions policy switches off what the site never uses, and keeps the two it does: the
# Copy buttons write to the clipboard, and the home page offers the device's share sheet.
/*
  Content-Security-Policy: default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), display-capture=(), browsing-topics=(), clipboard-write=(self), web-share=(self)
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# The components are there to be used from other sites. Modules and fetches
# across origins need this; the files are public anyway.
/ui/*
  Access-Control-Allow-Origin: *

# Font files change rarely, and are large next to everything else here.
/ui/fonts/*
  Cache-Control: public, max-age=604800
