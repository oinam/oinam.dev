# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Everything the site loads comes from the site itself, so the policy can say so.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
