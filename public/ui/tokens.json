{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Oinam UI: the tokens of Base, in the Design Tokens format (2025.10). The same values as tokens.css, which is what a page uses. Under each token's $extensions, 'dev.oinam.ui' gives the CSS custom property it is ('property'), its exact value in CSS ('css'), and, for a color, its value in the dark theme ('dark'); $value is the light theme.",
  "color": {
    "$type": "color",
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0941],
        "hex": "#161618"
      },
      "$description": "Text, and solid buttons. Nearly black in light, nearly white in dark.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--color-ink",
          "css": "light-dark(#161618, #eceef1)",
          "dark": {
            "colorSpace": "srgb",
            "components": [0.9255, 0.9333, 0.9451],
            "hex": "#eceef1"
          }
        }
      }
    },
    "cloud": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9608, 0.9647, 0.9725],
        "hex": "#f5f6f8"
      },
      "$description": "The page background. Nearly white in light, nearly black in dark.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--color-cloud",
          "css": "light-dark(#f5f6f8, #0c0c0c)",
          "dark": {
            "colorSpace": "srgb",
            "components": [0.0471, 0.0471, 0.0471],
            "hex": "#0c0c0c"
          }
        }
      }
    },
    "milk": {
