      "$value": {
        "colorSpace": "srgb",
        "components": [0.3294, 0.3294, 0.3412],
        "hex": "#545457"
      },
      "$description": "Secondary text. 68% ink mixed into cloud.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--color-ink-soft",
