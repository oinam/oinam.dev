  "font": {
    "$type": "fontFamily",
    "serif": {
      "$value": [
        "Iowan Old Style",
        "Apple Garamond",
        "baskerville",
        "Times New Roman",
        "Droid Serif",
        "times",
        "Source Serif Pro",
        "serif"
      ],
      "$description": "Headings.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--font-serif",
          "css": "\"Iowan Old Style\", \"Apple Garamond\", baskerville, \"Times New Roman\", \"Droid Serif\", times, \"Source Serif Pro\", serif"
        }
      }
    },
    "sans": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "roboto",
        "ubuntu",
        "cantarell",
        "Noto Sans",
        "sans-serif"
      ],
      "$description": "Everything that is not a heading or code.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--font-sans",
          "css": "system-ui, -apple-system, \"Segoe UI\", roboto, ubuntu, cantarell, \"Noto Sans\", sans-serif"
        }
      }
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "menlo",
        "consolas",
        "monaco",
        "Liberation Mono",
        "Lucida Console",
        "monospace"
      ],
      "$description": "Code, eyebrows, and badges.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--font-mono",
          "css": "ui-monospace, menlo, consolas, monaco, \"Liberation Mono\", \"Lucida Console\", monospace"
        }
      }
    },
    "heading": {
      "$value": "{font.serif}",
      "$description": "What headings are set in. The serif, unless a variation says otherwise.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--font-heading",
          "css": "var(--font-serif)"
        }
      }
    },
    "body": {
      "$value": "{font.sans}",
      "$description": "What everything else is set in. The sans, unless a variation says otherwise.",
      "$extensions": {
        "dev.oinam.ui": {
          "property": "--font-body",
          "css": "var(--font-sans)"
        }
      }
    }
  },
  "text": {
