{
  "$description": "Oinam UI: what each element and class accepts. For every custom element: its attributes and their values (true means the attribute stands alone, with no value; \"text\" means any text), what it must contain, and where it may not go. For every class: the elements it goes on, and its attributes. Anything not listed here is not part of the system. The linter, tools/lint.js, reads this file.",
  "global": [
    "id",
    "class",
    "role",
    "tabindex",
    "hidden",
    "title",
    "lang",
    "dir",
    "slot",
    "popover",
    "inert"
  ],
  "elements": {
    "onm-wrap": {
      "component": "wrap",
      "attributes": {
        "narrow": true
      }
    },
    "onm-stack": {
      "component": "stack",
      "attributes": {
        "gap": ["1", "2", "3", "4", "6", "8", "12", "16"],
        "align": ["start", "center"]
      }
    },
    "onm-row": {
      "component": "row",
      "attributes": {
        "gap": ["1", "2", "3", "4", "6", "8", "12", "16"],
        "align": ["start", "baseline"],
        "justify": ["between", "center", "end"]
      }
    },
    "onm-grid": {
      "component": "grid",
      "attributes": {
        "gap": ["1", "2", "3", "4", "6", "8", "12", "16"],
        "min": ["small", "large"]
      }
    },
    "onm-prose": {
      "component": "prose",
      "attributes": {}
    },
    "onm-card": {
      "component": "card",
      "attributes": {},
      "not_inside": ["onm-card"]
    },
    "onm-badge": {
      "component": "badge",
      "attributes": {
        "variant": ["solid"],
        "tone": ["success", "warning", "danger", "info"],
        "hue": ["1", "2", "3", "4", "5", "6"]
      }
    },
    "onm-alert": {
      "component": "alert",
      "attributes": {
        "variant": ["warning", "danger"],
        "tone": ["success", "warning", "danger", "info"]
      }
    },
    "onm-table": {
      "component": "table",
      "attributes": {},
      "contains": ["table"]
    },
    "onm-avatar": {
      "component": "avatar",
      "attributes": {
        "size": ["small", "large"]
      }
    },
    "onm-item": {
      "component": "item",
      "attributes": {}
    },
    "onm-empty": {
      "component": "empty",
      "attributes": {}
    },
    "onm-skeleton": {
      "component": "skeleton",
      "attributes": {
        "shape": ["circle", "block"]
      }
    },
    "onm-spinner": {
      "component": "spinner",
      "attributes": {}
    },
    "onm-ratio": {
      "component": "ratio",
      "attributes": {
        "ratio": ["4/3", "1/1", "21/9"]
      }
    },
    "onm-scroll": {
      "component": "scroll",
      "attributes": {}
    },
    "onm-button-group": {
      "component": "button-group",
      "attributes": {},
      "contains": [".onm-button"]
    },
    "onm-field": {
      "component": "field",
      "attributes": {},
      "contains": ["label"]
    },
    "onm-input-group": {
      "component": "input-group",
      "attributes": {},
      "contains": [".onm-input"]
    },
    "onm-toggle-group": {
      "component": "toggle",
      "attributes": {},
      "contains": [".onm-toggle"]
    },
    "onm-accordion": {
      "component": "accordion",
      "attributes": {},
      "contains": ["details"]
    },
    "onm-tabs": {
      "component": "tabs",
      "attributes": {
        "label": "text"
      },
      "contains": ["section"]
    },
    "onm-menu": {
      "component": "menu",
      "attributes": {
        "context": true
      },
      "contains": ["[popover]"]
    },
    "onm-tooltip": {
      "component": "tooltip",
      "attributes": {},
      "contains": ["[role=tooltip]"]
    },
    "onm-copy": {
      "component": "copy",
      "attributes": {},
      "contains": ["pre"]
    },
    "onm-theme": {
      "component": "theme",
      "attributes": {
        "auto": true
      },
      "contains": ["button"]
    },
    "onm-toast": {
      "component": "toast",
      "attributes": {}
    },
    "onm-example": {
      "component": "example",
      "attributes": {}
    }
  },
  "classes": {
    "onm-button": {
      "component": "button",
      "on": ["button", "a"],
      "attributes": {
        "data-variant": ["accent", "outline", "ghost"],
        "data-size": ["small", "large", "icon"],
        "aria-busy": ["true", "false"]
      }
    },
    "onm-input": {
      "component": "field",
      "on": ["input", "select", "textarea"],
      "attributes": {}
    },
    "onm-choice": {
      "component": "choice",
      "on": ["label"],
      "attributes": {}
    },
    "onm-slider": {
      "component": "slider",
      "on": ["input"],
      "attributes": {}
    },
    "onm-toggle": {
      "component": "toggle",
      "on": ["label"],
      "attributes": {}
    },
    "onm-progress": {
      "component": "progress",
      "on": ["progress"],
      "attributes": {}
    },
    "onm-dialog": {
      "component": "dialog",
      "on": ["dialog"],
      "attributes": {
        "data-side": ["right", "left", "bottom"]
      }
    },
    "onm-popover": {
      "component": "popover",
      "on": ["*"],
      "attributes": {}
    },
    "onm-breadcrumb": {
      "component": "breadcrumb",
      "on": ["nav"],
      "attributes": {}
    },
    "onm-pagination": {
      "component": "pagination",
      "on": ["nav"],
      "attributes": {}
    },
    "onm-eyebrow": {
      "component": "text",
      "on": ["*"],
      "attributes": {}
    },
    "onm-lede": {
      "component": "text",
      "on": ["p"],
      "attributes": {}
    },
    "onm-facts": {
      "component": "facts",
      "on": ["dl"],
      "attributes": {}
    }
  }
}
